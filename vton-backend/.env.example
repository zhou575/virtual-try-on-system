# Application
SECRET_KEY=replace-with-a-long-random-string
DATABASE_URL=sqlite:///./vton.db

# DashScope
DASHSCOPE_API_KEY=replace-with-your-dashscope-api-key

# Aliyun OSS
OSS_ACCESS_KEY_ID=replace-with-your-oss-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-access-key-secret
OSS_ENDPOINT=oss-cn-beijing.aliyuncs.com
OSS_BUCKET_NAME=replace-with-your-oss-bucket-name

# Volcengine visual service, if enabled
VOLC_ACCESSKEY=replace-with-your-volcengine-access-key
VOLC_SECRETKEY=replace-with-your-volcengine-secret-key
